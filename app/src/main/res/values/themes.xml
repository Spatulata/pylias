<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Pylias" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/purple_neon</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_soft</item>
        <item name="colorOnSecondary">@color/bg_deep</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="materialButtonStyle">@style/Widget.Pylias.Button</item>
    </style>

    <style name="Theme.Pylias" parent="Base.Theme.Pylias" />

    <style name="Widget.Pylias.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.Pylias.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_neon</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="TextAppearance.Pylias.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Pylias.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
