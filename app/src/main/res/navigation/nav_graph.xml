<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.pylias.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_gameSetupFragment"
            app:destination="@id/gameSetupFragment" />
    </fragment>

    <fragment
        android:id="@+id/modulesFragment"
        android:name="com.example.pylias.ui.modules.ModulesFragment"
        android:label="@string/nav_modules"
        tools:layout="@layout/fragment_modules">
        <action
            android:id="@+id/action_modulesFragment_to_moduleEditFragment"
            app:destination="@id/moduleEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/moduleEditFragment"
        android:name="com.example.pylias.ui.modules.ModuleEditFragment"
        android:label="@string/edit_module"
        tools:layout="@layout/fragment_module_edit">
        <argument
            android:name="moduleId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/gameSetupFragment"
        android:name="com.example.pylias.ui.setup.GameSetupFragment"
        android:label="@string/setup_title"
        tools:layout="@layout/fragment_game_setup">
        <argument
            android:name="moduleId"
            app:argType="string" />
        <action
            android:id="@+id/action_gameSetupFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </fragment>

    <fragment
        android:id="@+id/gameFragment"
        android:name="com.example.pylias.ui.game.GameFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_game">
        <action
            android:id="@+id/action_gameFragment_to_resultsFragment"
            app:destination="@id/resultsFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultsFragment"
        android:name="com.example.pylias.ui.results.ResultsFragment"
        android:label="@string/results_title"
        tools:layout="@layout/fragment_results">
        <action
            android:id="@+id/action_resultsFragment_to_gameSetupFragment"
            app:destination="@id/gameSetupFragment" />
        <action
            android:id="@+id/action_resultsFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.pylias.ui.about.AboutFragment"
        android:label="@string/nav_about"
        tools:layout="@layout/fragment_about" />

</navigation>
